{
  "info": {
    "_postman_id": "c8a41703-9e45-4df3-a120-cf9673a38da0",
    "name": "CCA Admin & Exam API",
    "description": "Postman Collection hoàn chỉnh cho hệ thống CCA Admin & Exam Engine trên Next.js (Vercel & Neon PostgreSQL). Đã tích hợp sẵn header CSRF/Origin, test scripts tự động lưu token và ID. Domain admin (APP_ORIGIN) chỉ cho admin đăng nhập/setup; các request học viên dùng frontendOrigin, phải có trong CCA_ALLOWED_ORIGINS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tự động bổ sung header Origin cho các mutation request (POST, PUT, DELETE)",
          "// nhằm vượt qua kiểm tra CSRF/Origin bảo mật của server",
          "if (pm.request.method !== 'GET' && pm.request.method !== 'HEAD') {",
          "    if (!pm.request.headers.has('Origin')) {",
          "        pm.request.headers.add({",
          "            key: 'Origin',",
          "            value: pm.variables.get('baseUrl') || 'http://localhost:3001'",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "admin_cca",
      "type": "string"
    },
