        {
          "name": "Get Current Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "if (data.session) {",
                  "    console.log(\"Phiên hiện tại:\", data.session.user.username, \"|\", data.session.user.role, \"|\", data.session.kind);",
                  "} else {",
                  "    console.log(\"Chưa đăng nhập (Anonymous session: null)\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "session"]
            },
            "description": "Đọc trạng thái phiên đăng nhập hiện tại từ cookie cca_session. Trả về thông tin user hoặc session: null nếu chưa đăng nhập."
          }
        },
