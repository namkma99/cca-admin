  "item": [
    {
      "name": "1. Authentication",
      "description": "Các API xác thực, đăng nhập, thiết lập mật khẩu lần đầu và quản lý phiên làm việc.",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Admin authenticated session granted\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.session).to.be.an('object');",
                  "    pm.expect(data.session.kind).to.eql('authenticated');",
                  "    pm.expect(data.session.user.role).to.eql('admin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Đăng nhập tài khoản Admin bằng username và mật khẩu chính thức. Máy chủ trả về Set-Cookie với thời hạn 24 giờ tuyệt đối."
          }
        },
        {
          "name": "Login (Student - First Setup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Session kind is password_setup (10 mins)\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.session).to.be.an('object');",
                  "    pm.expect(data.session.kind).to.eql('password_setup');",
                  "    pm.expect(data.session.user.role).to.eql('student');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentUsername}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Đăng nhập học viên lần đầu chỉ bằng username do Admin cấp. Trả về phiên ngắn hạn password_setup (10 phút) để chuyển hướng sang đổi mật khẩu."
          }
        },
