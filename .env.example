# Copy to .env.local. Do not commit credentials. Use a separate database for preview/test.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Configure when implementing authenticated cleanup. No Cron endpoint is active yet.
CRON_SECRET=
# Exact admin/API origin. Required HTTPS in production. Change if local port changes.
APP_ORIGIN=http://localhost:3001
# Exact exam frontend origins, comma separated; student login is only allowed here.
# Replace this local example with your frontend origin in production.
CCA_ALLOWED_ORIGINS=http://localhost:3000
